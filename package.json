    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@types/node": "^22.0.0",
    "copyfiles": "^2.4.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
