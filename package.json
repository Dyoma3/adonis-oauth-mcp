{
  "name": "adonis-oauth-mcp",
  "private": true,
  "type": "module",
  "description": "AdonisJS packages for an OAuth 2.1 authorization server and an MCP server",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
