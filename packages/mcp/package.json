{
  "name": "@dinko/adonis-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for AdonisJS, with tools built per request from the HttpContext",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./commands": "./build/commands/main.js",
    "./services/main": "./build/services/main.js",
    "./mcp_provider": "./build/providers/mcp_provider.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run copy:stubs && npm run index:commands",
    "copy:stubs": "copyfiles \"stubs/**/*.stub\" build",
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "index:commands": "adonis-kit index build/commands",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ts-morph": "^27.0.2 || ^28.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/assembler": "^8.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "ts-morph": {
      "optional": true
    }
  }
}
