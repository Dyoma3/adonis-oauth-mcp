{
  "name": "@dinko/adonis-oauth",
  "version": "0.1.0",
  "type": "module",
  "description": "OAuth 2.1 authorization server for AdonisJS, with a registry of protected resources",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./commands": "./build/commands/main.js",
    "./services/main": "./build/services/main.js",
    "./oauth_provider": "./build/providers/oauth_provider.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run copy:stubs && npm run index:commands",
    "copy:stubs": "copyfiles \"stubs/**/*.stub\" build",
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "index:commands": "adonis-kit index build/commands"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/lucid": "^22.4.2",
    "ts-morph": "^27.0.2"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "ts-morph": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/lucid": "^22.4.2",
    "@types/luxon": "^3.7.4",
    "ts-morph": "^27.0.2"
  }
}
