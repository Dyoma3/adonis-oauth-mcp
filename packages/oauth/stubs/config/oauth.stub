{{{
  exports({
    to: app.configPath('oauth.ts')
  })
}}}
import env from '#start/env'
import User from '#models/user'
import { defineConfig } from '@dinko/adonis-oauth'
import type { OAuthResourceConfig } from '@dinko/adonis-oauth/types'

/**
 * An example protected resource. Replace it with your own: "id" is the slug
 * used in its discovery URL (/.well-known/oauth-protected-resource/mcp), and
 * "resource" is the identifier clients send as the resource parameter.
 */
const mcpScopes = ['mcp:read', 'mcp:write'] as const
type McpScope = (typeof mcpScopes)[number]

const mcpResource: OAuthResourceConfig<McpScope> = {
  id: 'mcp',
  resource: \`\${env.get('APP_URL')}/mcp\`,
  resourceName: 'MCP',
  protectedResourceMetadataUrl: \`\${env.get('APP_URL')}/.well-known/oauth-protected-resource/mcp\`,
  scopes: [...mcpScopes],

  clients: [
    {
      id: 'claude',
      name: 'Claude',
      redirectUris: ['https://claude.ai/api/mcp/auth_callback'],
      allowedScopes: [...mcpScopes],
    },
  ],

  /**
   * Called once the authorization code has been validated and consumed. The
   * package has no access to your user model or your token provider, so
   * minting the token is up to you.
   *
   * Return null to reject the exchange with invalid_grant.
   */
  issueToken: async ({ userId, scopes, client }) => {
    const user = await User.find(userId)
    if (!user) return null

    const expiresIn = 30 * 24 * 60 * 60
    const token = await User.accessTokens.create(user, scopes, {
      name: \`oauth:\${client.id}\`,
      expiresIn,
    })

    return { accessToken: token.value!.release(), expiresIn }
  },
}

export default defineConfig({
  issuer: env.get('APP_URL'),

  /**
   * The consent screen belongs to your application, so this is only the URL
   * advertised through discovery.
   */
  authorizationEndpoint: \`\${env.get('APP_URL')}/oauth/authorize\`,
  tokenEndpoint: \`\${env.get('APP_URL')}/oauth/token\`,

  /**
   * How approve and deny hand the redirect back to the client.
   *
   * 'json' answers 200 with a redirect_to property, and the consent screen
   * navigates itself with window.location.assign. Use it whenever the screen
   * posts its decision with fetch or axios: an XHR follows a 302 by re-issuing
   * the request, so the page never navigates and the user is left where they
   * were, looking at the consent screen.
   *
   * 'http' answers 302. Use it when the consent screen is a plain HTML form,
   * where the browser is navigating the document and follows it natively.
   */
  redirectMode: 'json',

  resources: [mcpResource],
})
