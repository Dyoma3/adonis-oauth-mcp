{{{
  exports({
    to: app.httpControllersPath('oauth_controller.ts')
  })
}}}
import { inject } from '@adonisjs/core'
import { HttpContext } from '@adonisjs/core/http'
import {
  OAuthApproveAuthorization,
  OAuthDenyAuthorization,
  OAuthServer,
  OAuthTokenExchange,
} from '@dinko/adonis-oauth'

/**
 * Delegates to the package, which owns the protocol. Anything it does not
 * cover — a header, a different error body, a log — belongs here.
 *
 * The routes are in start/routes.ts.
 */
export default class OauthController {
  @inject()
  approveAuthorization(_ctx: HttpContext, authorization: OAuthApproveAuthorization) {
    return authorization.execute()
  }

  @inject()
  denyAuthorization(_ctx: HttpContext, authorization: OAuthDenyAuthorization) {
    return authorization.execute()
  }

  @inject()
  token(_ctx: HttpContext, exchange: OAuthTokenExchange) {
    return exchange.execute()
  }

  @inject()
  getAuthorizationServer({ response }: HttpContext, server: OAuthServer) {
    return response.ok(server.authorizationServerMetadata())
  }

  @inject()
  getProtectedResource({ params, response }: HttpContext, server: OAuthServer) {
    const metadata = server.protectedResourceMetadata(params.resource)
    if (!metadata) return response.notFound({ error: 'not_found' })

    return response.ok(metadata)
  }
}
